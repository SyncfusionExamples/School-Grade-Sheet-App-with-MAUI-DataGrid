<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:datagrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:popup="clr-namespace:Syncfusion.Maui.Popup;assembly=Syncfusion.Maui.Popup"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:local="clr-namespace:DataGridSample"
             x:Class="DataGridSample.MainPage">

    <ContentPage.BindingContext>
        <local:GradeSheetViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="popup:SfPopup">
                <Setter Property="ShowHeader" Value="False"/>
            </Style>

            <Style TargetType="core:SfChip">
                <Setter Property="StrokeThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <StackLayout Margin="5" Spacing="10" Orientation="Horizontal" HeightRequest="40">

            <core:SfChip  Text="Filter" VerticalOptions="Center" x:Name="Filter" Command="{Binding FilterColumns}"/>
            <popup:SfPopup HeightRequest="60" AutoSizeMode="Width" RelativeView="{x:Reference Filter}" 
                           IsOpen="{Binding IsOpenForFilterColumns}">
                <popup:SfPopup.ContentTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="10" Margin="10" VerticalOptions="Center">
                            <Label Text="&#xe755;"  FontFamily="MauiSampleFontIcon" VerticalOptions="Center" FontSize="18">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearFilter}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <editors:SfComboBox ItemsSource="{Binding SearchConditions}" SelectedItem="{Binding SelectedCondition}" 
                                                IsClearButtonVisible="False" WidthRequest="110" VerticalOptions="Center"/>
                            <editors:SfComboBox ItemsSource="{Binding GridColumnsForFilter}" DisplayMemberPath="DisplayName"  
                                                SelectedItem="{Binding SelectedColumn}" IsClearButtonVisible="False" 
                                                WidthRequest="140" VerticalOptions="Center">
                                <editors:SfComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </editors:SfComboBox.ItemTemplate>
                            </editors:SfComboBox>

                            <Border StrokeThickness="1" VerticalOptions="Center" BackgroundColor="White"
                                    HeightRequest="38" WidthRequest="120" StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,8,0">
                                    <Label Text="&#xe728;" FontFamily="MauiSampleFontIcon" VerticalOptions="Center" 
                                           HorizontalOptions="Center" FontSize="16" Margin="10,0,12,0" />
                                    <Entry x:Name="filterText" Text="{Binding FilterText}" Grid.Column="1"                                                     
                                           BackgroundColor="Transparent" FontFamily="Roboto-Regular" FontSize="16"                                                                                                
                                           HorizontalOptions="{OnPlatform Android='StartAndExpand',WinUI='End',MacCatalyst='End',iOS='FillAndExpand'}"
                                           VerticalTextAlignment="{OnPlatform Default=Start, MacCatalyst=Center, iOS=Center}"
                                           ClearButtonVisibility="Never" />
                                </Grid>
                            </Border>

                        </HorizontalStackLayout>
                    </DataTemplate>
                </popup:SfPopup.ContentTemplate>
            </popup:SfPopup>

            <core:SfChip  Text="Group" VerticalOptions="Center" x:Name="Group" Command="{Binding GroupColumns}"/>
            <popup:SfPopup IsOpen="{Binding IsOpenForGroupColumns}" HeightRequest="60" 
                           RelativeView="{x:Reference Group}" AutoSizeMode="Width">
                <popup:SfPopup.ContentTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="10" Margin="10" VerticalOptions="Center">
                            <Label Text="&#xe755;"  FontFamily="MauiSampleFontIcon" VerticalOptions="Center" FontSize="18">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearGroup}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <editors:SfComboBox ItemsSource="{Binding GridColumnsForGroup}" 
                                                DisplayMemberPath="DisplayName" 
                                                SelectedItem="{Binding SelectedGroupColumn}" 
                                                IsClearButtonVisible="False" WidthRequest="180" 
                                                VerticalOptions="Center">
                                <editors:SfComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </editors:SfComboBox.ItemTemplate>
                            </editors:SfComboBox>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </popup:SfPopup.ContentTemplate>
            </popup:SfPopup>

            <core:SfChip Text="Sort" VerticalOptions="Center" x:Name="Sort" Command="{Binding SortColumns}"/>
            <popup:SfPopup IsOpen="{Binding IsOpenForSortColumns}" HeightRequest="60" RelativeView="{x:Reference Sort}" 
                           AutoSizeMode="Width">
                <popup:SfPopup.ContentTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="10" Margin="10" VerticalOptions="Center">
                            <Label Text="&#xe755;"  FontFamily="MauiSampleFontIcon" VerticalOptions="Center" 
                                   FontSize="18">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClearSort}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <editors:SfComboBox ItemsSource="{Binding GridColumnsForSort}" 
                                                DisplayMemberPath="DisplayName" 
                                                SelectedItem="{Binding SelectedSortColumn}" 
                                                IsClearButtonVisible="False" WidthRequest="140" 
                                                VerticalOptions="Center">
                                <editors:SfComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </editors:SfComboBox.ItemTemplate>
                            </editors:SfComboBox>
                            <Label Text="DESC" VerticalOptions="Center" FontSize="14"/>
                            <buttons:SfSwitch IsOn="{Binding IsOnState}" VerticalOptions="Center" />
                            <Label Text="ASC" VerticalOptions="Center" FontSize="14" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </popup:SfPopup.ContentTemplate>
            </popup:SfPopup>
        </StackLayout>

        <datagrid:SfDataGrid x:Name="dataGrid" ColumnWidthMode="Auto" AutoGenerateColumnsMode="None" 
                             Grid.Row="1" SortColumnDescriptions="{Binding SortColumnDescriptions}"
                             GroupColumnDescriptions="{Binding GroupColumnDescriptions}"
                             Columns="{Binding Columns}" ItemsSource="{Binding Grades}">
            <datagrid:SfDataGrid.Behaviors>
                <local:FilteringBehavior/>
            </datagrid:SfDataGrid.Behaviors>
        </datagrid:SfDataGrid>
    </Grid>

</ContentPage>
